{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmiaie/ML_Sentiment_Augmented_Price_Predictor/data/manifests/manifest.schema.json",
  "title": "HistoricalDatasetManifest",
  "type": "object",
  "required": [
    "dataset_id",
    "source",
    "source_version",
    "symbols",
    "interval",
    "requested_start",
    "requested_end_exclusive",
    "actual_start",
    "actual_end",
    "row_counts",
    "missing_counts",
    "retrieval_timestamp_utc",
    "freeze_timestamp_utc",
    "status",
    "sha256",
    "parameters"
  ],
  "properties": {
    "dataset_id": {"type": "string"},
    "source": {"type": "string"},
    "source_version": {"type": ["string", "object"]},
    "symbols": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "interval": {"type": "string"},
    "requested_start": {"type": "string"},
    "requested_end_exclusive": {"type": "string"},
    "actual_start": {"type": "object"},
    "actual_end": {"type": "object"},
    "row_counts": {"type": "object"},
    "missing_counts": {"type": "object"},
    "retrieval_timestamp_utc": {"type": "string"},
    "freeze_timestamp_utc": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["ACQUIRED", "VALIDATED", "DATA FROZEN"]},
    "sha256": {"type": ["object", "null"]},
    "parameters": {"type": "object"},
    "notes": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
